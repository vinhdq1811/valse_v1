
<% content_for :page_css do %>
guest/posts
<% end %>
<section class="vp-hero vp-hero--detail">
  <div class="vp-container">
    <nav class="vp-breadcrumb vp-breadcrumb--light" aria-label="Breadcrumb">
      <%= link_to "Trang chủ", root_path %> <span>/</span>
      <%= link_to "Blog", blog_path %> <span>/</span>
      <%= link_to @post.category.name, blog_path, title: @post.category.name %>
    </nav>
    <h1 class="vp-hero__title"><%= @post.title %></h1>
    <div class="vp-post-meta vp-post-meta--light">
      <span><%= @post.author.display_name %></span>
      <span aria-hidden="true">•</span>
      <time datetime="<%= @post.published_at.to_date.iso8601 %>"><%= @post.display_date %></time>
    </div>
  </div>
</section>

<article class="vp-section">
  <div class="vp-container vp-article">
    <% if @post.featured_image.attached? %>
      <figure class="vp-article__figure">
        <%= image_tag @post.featured_image.variant(:large), alt: @post.title %>
      </figure>
    <% end %>

    <% if @post.excerpt.present? %>
      <p class="vp-article__lead"><%= @post.excerpt %></p>
    <% end %>

    <div class="vp-article__body">
      <%= @post.body %>
    </div>

    <% if @post.tags.any? %>
      <div class="vp-article__tags">
        <span class="vp-article__tags-label">Tags :</span>
        <% @post.tags.each do |tag| %>
          <span class="vp-article__tag"><%= tag.name %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</article>

<% if @related.any? %>
  <section class="vp-section vp-section--alt">
    <div class="vp-container">
      <h2 class="vp-heading vp-heading--left">Related Post</h2>
      <div class="vp-grid vp-grid--3 vp-posts">
        <% @related.each do |post| %>
          <%= render "post_card", post: post %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
