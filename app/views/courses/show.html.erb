<%# Trang Course Detail — nhân bản 1:1 layout App của mẫu Valse /course-detail/ (CSS: post-1144.css). Font giữ nguyên Playfair Display / Roboto qua post-8.css. %>
<% content_for :page_css do %>
guest/courses
guest/courses/show
<% end %>
<% content_for :page_js do %>
widgets/accordion
<% end %>
<%
  check_svg = '<svg aria-hidden="true" class="icon-svg icon-check" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z"></path></svg>'
  half = (@product.highlights.length.to_f / 2).ceil
  perks_left = @product.highlights.first(half)
  perks_right = @product.highlights.drop(half)
%>
<div data-page-type="site-page" data-page-id="1144" class="page-root page-course">
				<div class="block detail-hero section-flex section-boxed section section-parent" data-id="detail-hero" data-block-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="section-inner">
		<div class="block detail-hero-inner section-full section-flex section section-child" data-id="detail-hero-inner" data-block-type="container">
				<div class="block detail-breadcrumb link-list-layout-inline align-center link-list-fullwidth module module-icon-list" data-id="detail-breadcrumb" data-block-type="widget" data-module-type="icon-list.default">
				<div class="module-body">
							<ul class="link-list link-list-inline">
							<li class="link-list-item link-list-inline-item">
											<%= link_to root_path do %>

											<span class="link-list-text">Trang chủ</span>
											<% end %>
									</li>
								<li class="link-list-item link-list-inline-item">
											<span class="link-list-icon">
							<i aria-hidden="true" class="glyph glyph-angle-right"></i>						</span>
										<span class="link-list-text"></span>
									</li>
							<li class="link-list-item link-list-inline-item">
										<% if @product.category_course? %>
										<%= link_to courses_path do %>

										<span class="link-list-text"><%= category_label(@product.category) %> </span>
										<% end %>
										<% else %>
										<%= link_to products_path do %>

										<span class="link-list-text"><%= category_label(@product.category) %> </span>
										<% end %>
										<% end %>
								</li>
								<li class="link-list-item link-list-inline-item">
											<span class="link-list-icon">
							<i aria-hidden="true" class="glyph glyph-angle-right"></i>						</span>
										<span class="link-list-text"></span>
									</li>
								<li class="link-list-item link-list-inline-item">
											<span class="link-list-text"><%= @product.name %></span>
									</li>
						</ul>
						</div>
				</div>
				<div class="block detail-title module-width-initial module module-heading" data-id="detail-title" data-block-type="widget" data-module-type="heading.default">
				<div class="module-body">
					<h2 class="module-title size-default"><%= @product.name %></h2>				</div>
				</div>
				</div>
					</div>
				</div>
		<div class="block detail-textpath-section section-flex section-boxed section section-parent" data-id="detail-textpath-section" data-block-type="container">
					<div class="section-inner">
				<div class="block detail-textpath module-width-auto module module-text-path" data-id="detail-textpath" data-block-type="widget" data-settings="{&quot;text&quot;:&quot;Valse Chuyên khóa học piano và nhạc cụ&quot;,&quot;align&quot;:&quot;center&quot;,&quot;text_path_direction&quot;:&quot;rtl&quot;,&quot;link&quot;:{&quot;url&quot;:&quot;&quot;,&quot;is_external&quot;:&quot;&quot;,&quot;nofollow&quot;:&quot;&quot;,&quot;custom_attributes&quot;:&quot;&quot;},&quot;start_point&quot;:{&quot;unit&quot;:&quot;%&quot;,&quot;size&quot;:0,&quot;sizes&quot;:[]}}" data-module-type="text-path.default">
				<div class="module-body">
							<div class="text-ring" data-text="Valse Chuyên khóa học piano và nhạc cụ" data-url="<%= image_path('decor/circle-text.svg') %>" data-link-url=""></div>
						</div>
				</div>
					</div>
				</div>
		<div class="block detail-spacer-section section-flex section-boxed section section-parent" data-id="detail-spacer-section" data-block-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="section-inner">
				<div class="block detail-spacer module module-spacer" data-id="detail-spacer" data-block-type="widget" data-module-type="spacer.default">
				<div class="module-body">
							<div class="spacer">
			<div class="spacer-inner"></div>
		</div>
						</div>
				</div>
					</div>
				</div>
		<div class="block detail-intro-section section-flex section-boxed section section-parent" data-id="detail-intro-section" data-block-type="container">
					<div class="section-inner">
		<div class="block detail-intro section-full section-flex section section-child" data-id="detail-intro" data-block-type="container">
				<div class="block detail-about-title module module-heading" data-id="detail-about-title" data-block-type="widget" data-module-type="heading.default">
				<div class="module-body">
					<h2 class="module-title size-default">Giới thiệu</h2>				</div>
				</div>
				<div class="block detail-about-text module module-text" data-id="detail-about-text" data-block-type="widget" data-module-type="text-editor.default">
				<div class="module-body">
									<%= simple_format(@product.description) %>								</div>
				</div>
		<% if @plans.present? %>
		<div class="block detail-curriculum section-full section-flex section section-child" data-id="detail-curriculum" data-block-type="container">
				<div class="block detail-curriculum-title module module-heading" data-id="detail-curriculum-title" data-block-type="widget" data-module-type="heading.default">
				<div class="module-body">
					<h2 class="module-title size-default">Nội dung khóa học</h2>				</div>
				</div>
				<div class="block detail-curriculum-accordion module-width-initial module module-accordion" data-id="detail-curriculum-accordion" data-block-type="widget" data-module-type="ui_accordion.default">
				<div class="module-body">
					<div  class="js-widget ui-accordion style-default js-mod-3" ><% @plans.each do |plan| %><div class="card-wrapper ">
                <div class="card-header">
                    <a href="#expand-<%= plan.id %>" class="card-header-button" aria-expanded="false" data-target="#expand-<%= plan.id %>" aria-controls="expand-<%= plan.id %>">
                        <span class="title"><%= plan.name %>: <%= plan.tagline %></span><div class="right-icon-group">
                <div class="normal-icon"><i aria-hidden="true" class="glyph glyph-arrow-down"></i></div>
                <div class="active-icon"><i aria-hidden="true" class="glyph glyph-arrow-up"></i></div>
            </div>
                    </a>
                </div>
                <div class="card-expand" id="expand-<%= plan.id %>" style="display:none"><div class="card-body"><ul><li><p><strong><%= plan.name %> — <%= plan.duration %></strong><br /><%= plan.session_rule %></p></li><li><strong>Học phí</strong><br /><%= format_vnd(plan.price) %></li><% plan.features.each do |feature| %><li><%= feature %></li><% end %></ul></div></div>
            </div><% end %></div>				</div>
				</div>
				</div>
		<% end %>
		<div class="block detail-perks section-full section-flex section section-child" data-id="detail-perks" data-block-type="container">
				<div class="block detail-perks-title module module-heading" data-id="detail-perks-title" data-block-type="widget" data-module-type="heading.default">
				<div class="module-body">
					<h2 class="module-title size-default"><%= @product.category_course? ? "Bạn sẽ nhận được gì" : "Điểm nổi bật" %></h2>				</div>
				</div>
		<div class="block detail-perks-grid section-grid section-full section section-child" data-id="detail-perks-grid" data-block-type="container">
				<div class="block detail-perks-left module-width-initial link-list-layout-traditional link-list-fullwidth module module-icon-list" data-id="detail-perks-left" data-block-type="widget" data-module-type="icon-list.default">
				<div class="module-body">
							<ul class="link-list">
							<% perks_left.each do |perk| %><li class="link-list-item">
											<span class="link-list-icon">
							<%= check_svg.html_safe %>						</span>
										<span class="link-list-text"><%= perk %></span>
									</li>
								<% end %>
						</ul>
						</div>
				</div>
				<% if perks_right.present? %>
				<div class="block detail-perks-right module-width-initial link-list-layout-traditional link-list-fullwidth module module-icon-list" data-id="detail-perks-right" data-block-type="widget" data-module-type="icon-list.default">
				<div class="module-body">
							<ul class="link-list">
							<% perks_right.each do |perk| %><li class="link-list-item">
											<span class="link-list-icon">
							<%= check_svg.html_safe %>						</span>
										<span class="link-list-text"><%= perk %></span>
									</li>
								<% end %>
						</ul>
						</div>
				</div>
				<% end %>
				</div>
				</div>
				</div>
		<div class="block detail-cta-section section-full section-flex section section-child" data-id="detail-cta-section" data-block-type="container">
		<div class="block detail-cta-register section-full section-flex section section-child" data-id="detail-cta-register" data-block-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				<div class="block detail-cta-title module module-heading" data-id="detail-cta-title" data-block-type="widget" data-module-type="heading.default">
				<div class="module-body">
					<h2 class="module-title size-default">Mở khóa tiềm năng âm nhạc của bạn ngay hôm nay</h2>				</div>
				</div>
				<div class="block detail-cta-btn align-center module module-button" data-id="detail-cta-btn" data-block-type="widget" data-module-type="button.default">
				<div class="module-body">
									<div class="btn-theme-wrapper">
					<%= link_to contact_path, class: "btn-theme btn-theme-link size-sm" do %>
						<span class="btn-theme-content">
						<span class="btn-theme-icon">
				<i aria-hidden="true" class="glyph glyph-angle-right"></i>			</span>
									<span class="btn-theme-text">Đăng ký ngay</span>
					</span>
					<% end %>
				</div>
								</div>
				</div>
				</div>
		<div class="block detail-team-section section-full section-flex section section-child" data-id="detail-team-section" data-block-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				<div class="block detail-team-title module module-heading" data-id="detail-team-title" data-block-type="widget" data-module-type="heading.default">
				<div class="module-body">
					<h3 class="module-title size-default">Gặp gỡ đội ngũ giảng viên giàu kinh nghiệm</h3>				</div>
				</div>
				<div class="block detail-team-desc module module-text" data-id="detail-team-desc" data-block-type="widget" data-module-type="text-editor.default">
				<div class="module-body">
									<p>Đội ngũ giảng viên tận tâm, đồng hành cùng bạn trên từng nốt nhạc.</p>								</div>
				</div>
				<div class="block detail-team-btn align-mobile-center align-center module module-button" data-id="detail-team-btn" data-block-type="widget" data-module-type="button.default">
				<div class="module-body">
									<div class="btn-theme-wrapper">
					<%= link_to teachers_path, class: "btn-theme btn-theme-link size-sm anim-shrink" do %>
						<span class="btn-theme-content">
									<span class="btn-theme-text">Gặp đội ngũ</span>
					</span>
					<% end %>
				</div>
								</div>
				</div>
		<div class="block detail-team-gallery section-full section-flex section section-child" data-id="detail-team-gallery" data-block-type="container">
				<div class="block detail-team-img-1 module-width-initial module module-image" data-id="detail-team-img-1" data-block-type="widget" data-module-type="image.default">
				<div class="module-body">
															<img decoding="async" src="<%= image_path('photos/team-01.jpg') %>" title="team-01" alt="team-01" loading="lazy" />															</div>
				</div>
				<div class="block detail-team-img-2 module-width-initial module module-image" data-id="detail-team-img-2" data-block-type="widget" data-module-type="image.default">
				<div class="module-body">
															<img decoding="async" src="<%= image_path('photos/team-02.jpg') %>" title="team-02" alt="team-02" loading="lazy" />															</div>
				</div>
				<div class="block detail-team-img-3 module-width-initial module module-image" data-id="detail-team-img-3" data-block-type="widget" data-module-type="image.default">
				<div class="module-body">
															<img decoding="async" src="<%= image_path('photos/team-03.jpg') %>" title="team-03" alt="team-03" loading="lazy" />															</div>
				</div>
				</div>
				</div>
				</div>
					</div>
				</div>
				</div>
