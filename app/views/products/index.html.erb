<%# Trang Products — nhân bản layout /courses (App post-1111, CSS nạp qua
    page_css bên dưới) nhưng đã tinh gọn DOM so với bản gốc:
      - bỏ .module-body ở breadcrumb & tiêu đề
      - gộp .listing-hero-inner vào .section-inner
      - gộp .listing-card + .listing-card-box + .module-body thành 1 div
      - bỏ .btn-wrapper quanh nút "XEM CHI TIẾT"
    Các style từng gắn trên các div bọc đó được bù lại trong guest/products.css
    nên giao diện không đổi. Vẫn bỏ các section: listing-title-row, listing-intro,
    why-us, team, values (như bản gốc).
    Khác bản gốc: thêm section bộ lọc phân loại (Tất cả/Sheet nhạc/Đàn piano) giữa
    banner và listing; card dùng ảnh sản phẩm (product.image) vuông tràn viền,
    tiêu đề h4 cỡ nhỏ và card cùng hàng cao bằng nhau (xem guest/products.css). %>
<% content_for :page_css do %>
guest/courses/index
guest/products
<% end %>
<%# Trang không có counter (.stat-counter), form contactform, icon FA4 hay widget
    circle của ekit -> bỏ 4 script mặc định gắn ở footer %>
<% content_for :skip_fun_fact_js, "1" %>
<% content_for :skip_cute_alert_js, "1" %>
<%
  delays = [150, 200, 250, 300]
  filter_tabs = [["sheet", "Sheet nhạc"], ["piano", "Đàn piano"]]
%>
<div data-page-type="site-page" data-page-id="1111" class="page-root page-shop">
	<div class="block listing-hero section-flex section-boxed section section-parent" data-id="listing-hero" data-block-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
		<div class="section-inner">
			<div class="block listing-breadcrumb link-list-layout-inline align-center link-list-fullwidth module module-icon-list" data-id="listing-breadcrumb" data-block-type="widget" data-module-type="icon-list.default">
				<ul class="link-list link-list-inline">
					<li class="link-list-item link-list-inline-item">
						<%= link_to root_path do %><span class="link-list-text">Trang chủ</span><% end %>
					</li>
					<li class="link-list-item link-list-inline-item">
						<span class="link-list-icon"><i aria-hidden="true" class="glyph glyph-angle-right"></i></span>
						<span class="link-list-text"></span>
					</li>
<% if @category %>
					<li class="link-list-item link-list-inline-item">
						<%= link_to products_path do %><span class="link-list-text">Sản phẩm</span><% end %>
					</li>
					<li class="link-list-item link-list-inline-item">
						<span class="link-list-icon"><i aria-hidden="true" class="glyph glyph-angle-right"></i></span>
						<span class="link-list-text"></span>
					</li>
					<li class="link-list-item link-list-inline-item">
						<span class="link-list-text"><%= @page_title %></span>
					</li>
<% else %>
					<li class="link-list-item link-list-inline-item">
						<span class="link-list-text"><%= @page_title %></span>
					</li>
<% end %>
				</ul>
			</div>
			<div class="block listing-title module-width-initial module module-heading" data-id="listing-title" data-block-type="widget" data-module-type="heading.default">
				<h2 class="module-title size-default"><%= @page_title %></h2>
			</div>
		</div>
	</div>
	<div class="block listing-textpath-section section-flex section-boxed section section-parent" data-id="listing-textpath-section" data-block-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
		<div class="section-inner">
			<div class="block listing-textpath module-width-auto module module-text-path" data-id="listing-textpath" data-block-type="widget" data-settings="{&quot;text&quot;:&quot;Valse Chuyên khóa học piano và nhạc cụ&quot;,&quot;align&quot;:&quot;center&quot;,&quot;text_path_direction&quot;:&quot;rtl&quot;,&quot;link&quot;:{&quot;url&quot;:&quot;&quot;,&quot;is_external&quot;:&quot;&quot;,&quot;nofollow&quot;:&quot;&quot;,&quot;custom_attributes&quot;:&quot;&quot;},&quot;start_point&quot;:{&quot;unit&quot;:&quot;%&quot;,&quot;size&quot;:0,&quot;sizes&quot;:[]}}" data-module-type="text-path.default">
				<%# Giữ lại .module-body ở đây: style nền logo + JS text-path
				    của App gắn vào đúng tầng này %>
				<div class="module-body">
					<div class="text-ring" data-text="Valse Chuyên khóa học piano và nhạc cụ" data-url="<%= image_path('decor/circle-text.svg') %>" data-link-url=""></div>
				</div>
			</div>
		</div>
	</div>
	<div class="block listing-filter-section section-flex section-boxed section section-parent" data-id="listing-filter-section" data-block-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
		<div class="section-inner">
			<div class="block listing-filter module-width-auto module module-button" data-id="listing-filter" data-block-type="widget" data-module-type="button.default">
				<nav class="product-filter" aria-label="Phân loại sản phẩm">
					<%= link_to "Tất cả", products_path, class: "product-filter-btn" + (@category.nil? ? " is-active" : "") %>
<% filter_tabs.each do |key, label| %>
					<%= link_to label, products_path(category: key), class: "product-filter-btn" + (@category == key ? " is-active" : "") %>
<% end %>
				</nav>
			</div>
		</div>
	</div>
	<div class="block listing-section section-flex section-boxed section section-parent" data-id="listing-section" data-block-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
		<div class="section-inner">
			<div class="block listing-grid section-grid section-full section section-child" data-id="listing-grid" data-block-type="container">
<% @products.each_with_index do |product, i| %>
<% image_src = product.image.presence ? image_path(product.image) : image_path("icons/instrument-guitar.png") %>
				<div class="block listing-card listing-card-box module module-icon-box equal-height-on section-full section-flex anim-pending section section-child" data-id="listing-card" data-block-type="container" data-module-type="feature_card.default" data-settings="{&quot;animation&quot;:&quot;fadeInUp&quot;,&quot;animation_delay&quot;:<%= delays[i % delays.length] %>}">
					<div class="js-widget feature-card js-mod-3<%= product.id %>">
						<div class="feature-card-inner hover-left">
							<div class="feature-box feature-box-head">
								<div class="icon accent">
									<img loading="lazy" decoding="async" src="<%= image_src %>" class="image-full size-full" alt="<%= product.name %>" />
								</div>
							</div>
							<div class="feature-box feature-box-body">
								<h4 class="title"><%= product.name %></h4>
								<p class="feature-box-desc"><%= product.summary %></p>
								<div class="feature-box-btn">
									<%= link_to product_path(product), class: "feature-box-link", aria: { label: "XEM CHI TIẾT" } do %>XEM CHI TIẾT<% end %>
								</div>
							</div>
						</div>
					</div>
				</div>
<% end %>
			</div>
		</div>
	</div>
</div>
