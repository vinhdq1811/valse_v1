<%# Trang Products — nhân bản layout /courses (Elementor post-1111) nhưng bỏ các section:
    listing-title-row (tiêu đề "Các khóa học chuyên biệt"), listing-intro (mô tả + nút Liên hệ),
    why-us-section ("Vì sao chọn chúng tôi"), team-section ("Đội ngũ giáo viên"), values-section ("Giá trị cốt lõi") %>
<%
  card_icons = %w[icon-01 icon-02 icon-04 icon-03 icon-05 icon-06 icon-07 icon-08]
  delays = [150, 200, 250, 300]
%>
<div data-elementor-type="wp-page" data-elementor-id="1111" class="el-root el-1111">
				<div class="el-element el-listing-hero e-flex e-con-boxed e-con e-parent" data-id="listing-hero" data-element_type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
		<div class="el-element el-listing-hero-inner e-con-full e-flex e-con e-child" data-id="listing-hero-inner" data-element_type="container">
				<div class="el-element el-listing-breadcrumb el-icon-list--layout-inline el-align-center el-list-item-link-full_width el-widget el-widget-icon-list" data-id="listing-breadcrumb" data-element_type="widget" data-widget_type="icon-list.default">
				<div class="el-widget-container">
							<ul class="el-icon-list-items el-inline-items">
							<li class="el-icon-list-item el-inline-item">
											<%= link_to root_path do %>

											<span class="el-icon-list-text">Trang chủ</span>
											<% end %>
									</li>
								<li class="el-icon-list-item el-inline-item">
											<span class="el-icon-list-icon">
							<i aria-hidden="true" class="jki jki-angle-right-solid"></i>						</span>
										<span class="el-icon-list-text"></span>
									</li>
								<% if @category %>
								<li class="el-icon-list-item el-inline-item">
											<%= link_to products_path do %>

											<span class="el-icon-list-text">Sản phẩm</span>
											<% end %>
									</li>
								<li class="el-icon-list-item el-inline-item">
											<span class="el-icon-list-icon">
							<i aria-hidden="true" class="jki jki-angle-right-solid"></i>						</span>
										<span class="el-icon-list-text"></span>
									</li>
								<li class="el-icon-list-item el-inline-item">
											<span class="el-icon-list-text"><%= @page_title %></span>
									</li>
								<% else %>
								<li class="el-icon-list-item el-inline-item">
											<span class="el-icon-list-text"><%= @page_title %></span>
									</li>
								<% end %>
						</ul>
						</div>
				</div>
				<div class="el-element el-listing-title el-widget__width-initial el-widget el-widget-heading" data-id="listing-title" data-element_type="widget" data-widget_type="heading.default">
				<div class="el-widget-container">
					<h2 class="el-heading-title el-size-default"><%= @page_title %></h2>				</div>
				</div>
				</div>
					</div>
				</div>
		<div class="el-element el-listing-textpath-section e-flex e-con-boxed e-con e-parent" data-id="listing-textpath-section" data-element_type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
				<div class="el-element el-listing-textpath el-widget__width-auto el-widget el-widget-text-path" data-id="listing-textpath" data-element_type="widget" data-settings="{&quot;text&quot;:&quot;Valse Chuyên khóa học piano và nhạc cụ&quot;,&quot;align&quot;:&quot;center&quot;,&quot;text_path_direction&quot;:&quot;rtl&quot;,&quot;link&quot;:{&quot;url&quot;:&quot;&quot;,&quot;is_external&quot;:&quot;&quot;,&quot;nofollow&quot;:&quot;&quot;,&quot;custom_attributes&quot;:&quot;&quot;},&quot;start_point&quot;:{&quot;unit&quot;:&quot;%&quot;,&quot;size&quot;:0,&quot;sizes&quot;:[]}}" data-widget_type="text-path.default">
				<div class="el-widget-container">
							<div class="e-text-path" data-text="Valse Chuyên khóa học piano và nhạc cụ" data-url="/wp-content/plugins/elementor/assets/svg-paths/circle.svg" data-link-url=""></div>
						</div>
				</div>
					</div>
				</div>
		<div class="el-element el-listing-section e-flex e-con-boxed e-con e-parent" data-id="listing-section" data-element_type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
		<div class="el-element el-listing-grid e-grid e-con-full e-con e-child" data-id="listing-grid" data-element_type="container">
		<% @products.each_with_index do |product, i| %>
		<% icon = card_icons[i % card_icons.length] %>
		<% icon_src = i % card_icons.length < 4 ? "/wp-content/uploads/2024/08/#{icon}.png" : "/wp-content/uploads/2024/10/#{icon}.png" %>
		<div class="el-element el-listing-card e-con-full e-flex el-invisible e-con e-child" data-id="listing-card" data-element_type="container" data-settings="{&quot;animation&quot;:&quot;fadeInUp&quot;,&quot;animation_delay&quot;:<%= delays[i % delays.length] %>}">
				<div class="el-element el-listing-card-box jkit-equal-height-disable el-widget el-widget-jkit_icon_box" data-id="listing-card-box" data-element_type="widget" data-widget_type="jkit_icon_box.default">
				<div class="el-widget-container">
					<div  class="jeg-el-kit jkit-icon-box icon-position- el-animation- jeg_module_1111_3_<%= product.id %>" ><div class="jkit-icon-box-wrapper hover-from-left"><div class="icon-box icon-box-header el-animation-"><div class="icon style-color"><img loading="lazy" decoding="async" width="626" height="626" src="<%= icon_src %>" class="attachment-full size-full" alt="<%= product.name %>" srcset="<%= icon_src %> 626w, <%= icon_src.sub('.png', '-300x300.png') %> 300w, <%= icon_src.sub('.png', '-150x150.png') %> 150w" sizes="(max-width: 626px) 100vw, 626px" /></div></div><div class="icon-box icon-box-body">
                <h4 class="title"><%= product.name %></h4><p class="icon-box-description"><%= product.summary %></p><div class="icon-box-button ">
                <div class="btn-wrapper icon-position-before">
                    <%= link_to product_path(product), class: "icon-box-link", aria: { label: "XEM CHI TIẾT" } do %>XEM CHI TIẾT<% end %>
                </div>
            </div>
            </div>

            </div></div>				</div>
				</div>
				</div>
		<% end %>
				</div>
					</div>
				</div>
				</div>
