<%# Liên hệ — trích từ docs/design-reference/contact.html (App page 1349).
    Form Enquiry là form Rails thường (POST /contact), không còn render bằng
    React/metform. Markup bên dưới tái tạo y hệt DOM mà React trước giờ render
    (class .contact-form-content/.contact-form-main/.cf-input-wrapper/...) để
    CSS trong guest/pages/contact.css áp dụng không đổi. %>
<% content_for :page_css do %>
guest/pages/contact
<% end %>
<%# cm: model phục vụ form — nil ở lần GET đầu, có errors khi submit lỗi %>
<% cm = @contact_message %>
<% field_error = lambda do |attr|
     next nil unless cm&.errors&.include?(attr)
     attr == :email && cm.errors.of_kind?(attr, :invalid) ? "Please enter a valid Email address" : "This field is required."
   end %>
<% show_error_alert = cm&.errors&.any? %>
<%# Text alert gốc của metform là tiếng Anh — gom lỗi về 2 loại message đó %>
<% error_alerts =
     show_error_alert ? cm.errors.messages.flat_map { |attr, _msgs|
       [attr == :email && cm.errors.of_kind?(attr, :invalid) ? "Please enter a valid Email address" : "This field is required."]
     }.uniq : [] %>
