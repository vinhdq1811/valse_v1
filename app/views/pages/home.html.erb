<!-- ===== ABOUT ===== -->
<section class="about section" id="about">
  <div class="container about__inner">
    <div class="about__media">
      <div class="about__img-1"><%= image_tag "about-1.jpg", alt: "Không gian học âm nhạc tại Valse" %></div>
      <div class="about__img-2"><%= image_tag "about-2.jpg", alt: "Giảng viên guitar hướng dẫn học viên" %></div>
      <div class="about__exp"><strong>15+</strong><span>Năm ươm mầm<br>tài năng</span></div>
    </div>
    <div class="about__content">
      <p class="eyebrow"><span class="eyebrow__line eyebrow__line--dark"></span> Về Valse</p>
      <h2 class="section-title">Nơi cảm xúc cất lời<br>bằng <em>âm nhạc</em></h2>
      <p class="section-desc">Thành lập từ năm 2011, Valse tự hào là trường âm nhạc chuẩn quốc tế với phương pháp giảng dạy cá nhân hóa cho từng học viên — từ trẻ em đến người lớn, từ người mới bắt đầu đến thí sinh chuyên nghiệp.</p>
      <ul class="about__list">
        <li><span class="check"><svg viewBox="0 0 24 24"><path d="m9.5 16.2-3.7-3.7L4.4 14l5.1 5.1L20 8.6l-1.4-1.4z"/></svg></span> Giáo trình chuẩn quốc tế ABRSM &amp; Trinity</li>
        <li><span class="check"><svg viewBox="0 0 24 24"><path d="m9.5 16.2-3.7-3.7L4.4 14l5.1 5.1L20 8.6l-1.4-1.4z"/></svg></span> Học 1-kèm-1 hoặc nhóm nhỏ tối đa 4 người</li>
        <li><span class="check"><svg viewBox="0 0 24 24"><path d="m9.5 16.2-3.7-3.7L4.4 14l5.1 5.1L20 8.6l-1.4-1.4z"/></svg></span> Đàn &amp; thiết kế cao cấp, phòng tập tiêu chuẩn biểu diễn</li>
        <li><span class="check"><svg viewBox="0 0 24 24"><path d="m9.5 16.2-3.7-3.7L4.4 14l5.1 5.1L20 8.6l-1.4-1.4z"/></svg></span> Sân khấu trình diễn định kỳ mỗi tháng</li>
      </ul>
      <div class="about__actions">
        <a href="#teachers" class="btn btn--dark">Gặp gỡ giảng viên</a>
        <div class="about__call">
          <strong>0987 654 321</strong>
          <span>Gọi để được tư vấn miễn phí</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== COURSES ===== -->
<section class="courses section section--cream" id="courses">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow"><span class="eyebrow__line eyebrow__line--dark"></span> Khóa học nổi bật</p>
        <h2 class="section-title">Chọn nhạc cụ <em>của riêng bạn</em></h2>
      </div>
      <a href="#" class="btn btn--outline">Xem tất cả khóa học</a>
    </div>

    <div class="courses__grid">
      <% @courses = [
        { img: "course-piano.jpg",  tag: "Nhạc cụ", title: "Piano",          age: "Từ 5 tuổi",   price: "2.400.000đ" },
        { img: "course-guitar.jpg", tag: "Nhạc cụ", title: "Guitar",         age: "Từ 7 tuổi",   price: "1.800.000đ" },
        { img: "course-violin.jpg", tag: "Nhạc cụ", title: "Violin",         age: "Từ 6 tuổi",   price: "2.600.000đ" },
        { img: "course-drums.jpg",  tag: "Nhạc cụ", title: "Trống / Drum",   age: "Từ 6 tuổi",   price: "1.900.000đ" },
        { img: "course-vocal.jpg",  tag: "Thanh nhạc", title: "Thanh nhạc",  age: "Mọi lứa tuổi", price: "2.200.000đ" },
        { img: "course-sax.jpg",    tag: "Nhạc cụ", title: "Saxophone",      age: "Từ 8 tuổi",   price: "2.500.000đ" }
