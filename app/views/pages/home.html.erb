<!-- ===== HERO ===== -->
<section class="hero" id="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow"><span class="eyebrow__line"></span> Trường âm nhạc hàng đầu Việt Nam</p>
      <h1 class="hero__title">Bước vào thế giới<br><em>âm nhạc</em> cùng <span class="accent">Valse</span></h1>
      <p class="hero__desc">Từ những nốt nhạc đầu tiên đến sân khấu chuyên nghiệp — chúng tôi đồng hành cùng đam mê của bạn với đội ngũ giảng viên tận tâm và chương trình học cá nhân hóa.</p>
      <div class="hero__actions">
        <a href="#courses" class="btn btn--dark">Khám phá khóa học
          <svg viewBox="0 0 24 24" class="btn__ic"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#contact" class="btn btn--ghost">▶ &nbsp;Xem video giới thiệu</a>
      </div>
      <div class="hero__stats">
        <div class="stat"><strong>15+</strong><span>Năm kinh nghiệm</span></div>
        <div class="stat"><strong>2.500+</strong><span>Học viên theo học</span></div>
        <div class="stat"><strong>30+</strong><span>Giảng viên chuyên nghiệp</span></div>
      </div>
    </div>

    <div class="hero__media">
      <div class="hero__img-main">
        <%= image_tag "hero-main.jpg", alt: "Học viên đang chơi đàn piano tại Valse" %>
      </div>
      <div class="hero__img-small">
        <%= image_tag "hero-small.jpg", alt: "Nhạc lý và sheet nhạc" %>
      </div>
      <div class="hero__badge">
        <strong>98%</strong>
        <span>Học viên<br>hài lòng</span>
      </div>
      <div class="hero__note hero__note--1"><svg viewBox="0 0 24 24"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/></svg></div>
    </div>
  </div>
</section>

