      <% @courses.each do |c| %>
        <article class="course-card">
          <div class="course-card__img">
            <%= image_tag c[:img], alt: "Khóa học #{c[:title]} tại Valse" %>
            <span class="course-card__tag"><%= c[:tag] %></span>
          </div>
          <div class="course-card__body">
            <h3><a href="#"><%= c[:title] %></a></h3>
            <div class="course-card__meta">
              <span><svg viewBox="0 0 24 24" class="ic"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-3.3 0-8 1.7-8 5v1h16v-1c0-3.3-4.7-5-8-5z"/></svg> <%= c[:age] %></span>
              <span><svg viewBox="0 0 24 24" class="ic"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 10.4 3.5 2.1-.8 1.3L11 13V7h2v5.4z"/></svg> 60 phút/buổi</span>
            </div>
            <div class="course-card__foot">
              <span class="price"><%= c[:price] %><small>/khóa 8 buổi</small></span>
              <a href="#" class="course-card__more" aria-label="Xem chi tiết"><svg viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

