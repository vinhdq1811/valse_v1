<!-- ===== TESTIMONIALS ===== -->
<section class="testimonials section">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow"><span class="eyebrow__line eyebrow__line--dark"></span> Học viên nói gì</p>
      <h2 class="section-title">Những câu chuyện <em>đáng yêu</em></h2>
    </div>
    <div class="testimonials__grid">
      <% @reviews = [
        { name: "Chị Ngọc Anh", meta: "Phụ huynh bé Bảo Ngân (7 tuổi) · Piano", text: "Con từ nhút nhát giờ đã tự tin biểu diễn trước cả trường. Thầy cô ở Valse rất tận tâm, cô giáo luôn gửi video feedback sau mỗi buổi học." },
        { name: "Anh Hoàng Việt", meta: "Học viên lớp Guitar trưởng thành", text: "25 tuổi mới bắt đầu học guitar, cứ nghĩ là muộn nhưng lộ trình ở Valse giúp mình chơi được cả bài hoàn chỉnh chỉ sau 3 tháng. Đáng đồng tiền!" },
        { name: "Minh Châu", meta: "Học viên Thanh nhạc · 16 tuổi", text: "Mình đã đỗ vào ngành Thanh nhạc ĐH Văn hóa Nghệ thuật. Cảm ơn cô Mỹ Linh đã kiên nhẫn sửa từng hơi thở, từng nốt cho em suốt 2 năm qua." }
      ] %>
      <% @reviews.each do |r| %>
        <article class="quote-card">
          <div class="quote-card__stars">★★★★★</div>
          <p class="quote-card__text">“<%= r[:text] %>”</p>
          <div class="quote-card__author">
            <div class="quote-card__avatar"><%= r[:name][/\w+/] %></div>
            <div>
              <strong><%= r[:name] %></strong>
              <span><%= r[:meta] %></span>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<!-- ===== NEWS ===== -->
<section class="news section section--cream" id="news">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow"><span class="eyebrow__line eyebrow__line--dark"></span> Tin tức &amp; sự kiện</p>
        <h2 class="section-title">Diễn biến tại <em>Valse</em></h2>
      </div>
      <a href="#" class="btn btn--outline">Xem tất cả</a>
    </div>
    <div class="news__grid">
      <% @posts = [
        { img: "hero-small.jpg",      date: "20/09/2026", cat: "Sự kiện", title: "Recital mùa thu 2026: Sân khấu dành riêng cho học viên" },
        { img: "course-sax.jpg",      date: "05/09/2026", cat: "Tuyển sinh", title: "Mở lớp Saxophone khối thiếu nhi — ưu đãi 20% tháng 9" },
        { img: "course-violin.jpg",   date: "28/08/2026", cat: "Thành tích", title: "9 học viên Valse đạt đỗ kỳ thi ABRSM với điểm cao" }
      ] %>
      <% @posts.each do |p| %>
        <article class="news-card">
          <div class="news-card__img">
            <%= image_tag p[:img], alt: p[:title] %>
            <span class="news-card__date"><%= p[:date] %></span>
          </div>
          <div class="news-card__body">
            <span class="news-card__cat"><%= p[:cat] %></span>
            <h3><a href="#"><%= p[:title] %></a></h3>
            <a href="#" class="news-card__link">Đọc tiếp
              <svg viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta" id="contact">
  <div class="cta__bg"><%= image_tag "cta-bg.jpg", alt: "" %></div>
  <div class="container cta__inner">
    <h2 class="section-title section-title--light">Đăng ký <em>buổi học thử miễn phí</em> hôm nay</h2>
    <p class="cta__desc">Trải nghiệm 1 buổi học cùng giảng viên, được tư vấn lộ trình phù hợp — hoàn toàn miễn phí và không ràng buộc.</p>
    <form class="cta__form" action="#" method="post">
      <input type="text" name="name" placeholder="Tên của bạn" required>
      <input type="tel" name="phone" placeholder="Số điện thoại" required>
      <select name="course" required>
        <option value="" selected disabled>Chọn nhạc cụ</option>
        <option>Piano</option><option>Guitar</option><option>Violin</option>
        <option>Trống</option><option>Thanh nhạc</option><option>Saxophone</option>
      </select>
      <button type="submit" class="btn btn--amber">Đăng ký ngay</button>
    </form>
  </div>
</section>

