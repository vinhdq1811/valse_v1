<%# Layout Auth (nested) — phiên bản gọn của layout theme, KHÔNG có header/footer.
    Dùng cho các trang đăng nhập / đăng ký / quên mật khẩu. %>
<% content_for :html_lang, "en-US" %>
<% content_for :theme_head do %>
	<meta name='robots' content='max-image-preview:large' />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap", media: "all" %>
	<%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap", media: "all" %>
	<meta name="theme-color" content="#FFFFFF">
	<link rel="icon" href="<%= image_path("favicon-150x150.png") %>" sizes="32x32" />
	<link rel="icon" href="<%= image_path("favicon-300x300.png") %>" sizes="192x192" />
	<link rel="apple-touch-icon" href="<%= image_path("favicon-300x300.png") %>" />
	<meta name="msapplication-TileImage" content="<%= image_path("favicon-300x300.png") %>" />
<% end %>
<% content_for :body_attrs do %>class="page color-scheme site-skin"<% end %>
<%= render template: "layouts/application" %>
