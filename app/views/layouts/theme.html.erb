<%# Layout Valse (nested) — bọc trong application layout.
    Dùng cho các trang guest có header/footer (home, courses, blog, ...).
    CSS dùng chung đã gộp vào guest/style.css do application layout nạp;
    layout này chỉ khai báo font, favicon và thuộc tính body. %>
<% content_for :html_lang, "en-US" %>
<% content_for :theme_head do %>
	<meta name='robots' content='max-image-preview:large' />
	<%# Font: Google Fonts (Playfair Display, Roboto) + Lora tự host (guest/style.css) %>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap", media: "all" %>
	<%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap", media: "all" %>
	<%# jQuery phải có mặt đồng bộ trong head: script inline ở footer (jquery-ui-core-js-before)
	    tham chiếu jQuery ngay khi parse, còn frontend.min định nghĩa appModules mà
	    toàn bộ widget script (defer) phụ thuộc vào — thiếu jQuery làm mọi widget
	    (slider, animated-text, nav-menu, animation reveal) không khởi tạo. %>
	<%= javascript_include_tag "vendor/jquery/jquery.min", id: "jquery-core-js" %>
	<%= javascript_include_tag "vendor/jquery/jquery-migrate.min", id: "jquery-migrate-js" %>
	<%# Lazy-load ảnh nền: section ngoài màn hình đầu không tải ảnh cho tới khi
	    vào viewport (vòng tròn chữ xoay text-ring dùng data-url riêng nên không ảnh hưởng) %>
	<style>
		.section.section-parent:nth-of-type(n+4):not(.bg-loaded):not(.bg-no-lazy),
		.section.section-parent:nth-of-type(n+4):not(.bg-loaded):not(.bg-no-lazy) * {
			background-image: none !important;
		}
		@media screen and (max-height: 1024px) {
			.section.section-parent:nth-of-type(n+3):not(.bg-loaded):not(.bg-no-lazy),
			.section.section-parent:nth-of-type(n+3):not(.bg-loaded):not(.bg-no-lazy) * {
				background-image: none !important;
			}
		}
		@media screen and (max-height: 640px) {
			.section.section-parent:nth-of-type(n+2):not(.bg-loaded):not(.bg-no-lazy),
			.section.section-parent:nth-of-type(n+2):not(.bg-loaded):not(.bg-no-lazy) * {
				background-image: none !important;
			}
		}
	</style>
	<meta name="theme-color" content="#FFFFFF">
	<link rel="icon" href="<%= image_path("favicon-150x150.png") %>" sizes="32x32" />
	<link rel="icon" href="<%= image_path("favicon-300x300.png") %>" sizes="192x192" />
	<link rel="apple-touch-icon" href="<%= image_path("favicon-300x300.png") %>" />
	<meta name="msapplication-TileImage" content="<%= image_path("favicon-300x300.png") %>" />
<% end %>
<%# Block form để giữ html_safe — content_for dạng string sẽ bị escape ở Rails 8.1 %>
<% content_for :body_attrs do %>class="page color-scheme site-skin"<% end %>
<% content_for :layout_content do %>
<%= render "layouts/theme/header" %>
<% if flash[:notice] || flash[:alert] %>
  <div class="vp-flash-wrap">
    <div class="vp-container">
      <% if flash[:notice] %><p class="vp-flash vp-flash--notice"><%= flash[:notice] %></p><% end %>
      <% if flash[:alert] %><p class="vp-flash vp-flash--alert"><%= flash[:alert] %></p><% end %>
    </div>
  </div>
<% end %>
<%= yield %>
<%= render "layouts/theme/footer" %>
<% end %>
<%= render template: "layouts/application" %>
