<!DOCTYPE html>
<html lang="vi">
  <head>
    <title><%= content_for(:title) || "Quản trị — Valse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body" data-controller="admin-sidebar">
    <div class="admin-overlay" data-admin-sidebar-target="overlay" data-action="click->admin-sidebar#close"></div>

    <aside class="admin-sidebar" id="admin-sidebar" data-admin-sidebar-target="sidebar">
      <div class="admin-sidebar__brand">
        <span class="admin-sidebar__logo">V</span>
        <span class="admin-sidebar__brand-text">
          <strong class="admin-sidebar__title">Valse</strong>
          <span class="admin-sidebar__subtitle">Trang quản trị</span>
        </span>
        <button type="button" class="admin-sidebar__close" data-action="admin-sidebar#close" aria-label="Đóng menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <nav class="admin-sidebar__nav">
        <p class="admin-sidebar__label">Quản lý nội dung</p>

        <%= link_to admin_testimonials_path,
              class: class_names("admin-nav__link", "admin-nav__link--active": controller.controller_path == "admin/testimonials") do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span>Testimonials</span>
        <% end %>

        <%= link_to admin_posts_path,
              class: class_names("admin-nav__link", "admin-nav__link--active": controller.controller_path == "admin/posts") do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span>Bài viết</span>
        <% end %>

        <%= link_to admin_categories_path,
              class: class_names("admin-nav__link", "admin-nav__link--active": controller.controller_path == "admin/categories") do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          <span>Danh mục</span>
        <% end %>

        <%= link_to admin_tags_path,
              class: class_names("admin-nav__link", "admin-nav__link--active": controller.controller_path == "admin/tags") do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <span>Tags</span>
        <% end %>
      </nav>

      <div class="admin-sidebar__footer">
        <div class="admin-user">
          <span class="admin-user__avatar"><%= Current.user.initials %></span>
          <span class="admin-user__meta">
            <strong class="admin-user__name"><%= Current.user.display_name %></strong>
            <span class="admin-user__role"><%= Current.user.role.humanize %></span>
          </span>
        </div>
        <%= button_to session_path, method: :delete, class: "admin-user__logout", title: "Đăng xuất" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Đăng xuất</span>
        <% end %>
      </div>
    </aside>

    <div class="admin-shell">
      <header class="admin-topbar">
        <% section_labels = {
             "testimonials" => "Testimonials",
             "posts" => "Bài viết",
             "categories" => "Danh mục",
             "tags" => "Tags"
           } %>
        <button type="button" class="admin-topbar__menu" data-action="admin-sidebar#toggle" aria-label="Mở menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <span class="admin-topbar__section"><%= section_labels[controller.controller_name] || "Tổng quan" %></span>
        <%= link_to root_path, target: "_top", class: "admin-topbar__site" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          <span>Xem website</span>
        <% end %>
      </header>

      <main class="admin-main">
        <% if flash[:notice] %><p class="admin-flash admin-flash--notice"><%= flash[:notice] %></p><% end %>
        <% if flash[:alert] %><p class="admin-flash admin-flash--alert"><%= flash[:alert] %></p><% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
