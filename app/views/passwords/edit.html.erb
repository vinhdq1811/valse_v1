<section class="vp-auth">
  <div class="vp-container">
    <div class="vp-auth__card">
      <div class="vp-auth__badge" aria-hidden="true">♪</div>
      <p class="vp-auth__eyebrow">Valse Music School</p>
      <h1 class="vp-auth__title">Đặt lại mật khẩu</h1>
      <p class="vp-auth__sub">Tạo mật khẩu mới cho tài khoản của bạn.</p>

      <% if flash[:alert] %>
        <div class="vp-auth__flash vp-auth__flash--alert" role="alert"><%= flash[:alert] %></div>
      <% end %>

      <%= form_with url: password_path(params[:token]), method: :put, class: "vp-auth__form" do |form| %>
        <div class="vp-auth__field">
          <%= form.label :password, "Mật khẩu mới", class: "vp-auth__label" %>
          <%= form.password_field :password, required: true, autofocus: true,
                autocomplete: "new-password", placeholder: "Tối thiểu 8 ký tự",
                minlength: 8, maxlength: 72, class: "vp-auth__input" %>
        </div>
        <div class="vp-auth__field">
          <%= form.label :password_confirmation, "Xác nhận mật khẩu mới", class: "vp-auth__label" %>
          <%= form.password_field :password_confirmation, required: true,
                autocomplete: "new-password", placeholder: "Nhập lại mật khẩu mới",
                maxlength: 72, class: "vp-auth__input" %>
        </div>
        <%= form.submit "Lưu mật khẩu mới", class: "vp-btn vp-btn--full vp-auth__submit" %>
      <% end %>
    </div>
    <div class="vp-auth__back"><%= link_to "← Về trang đăng nhập", new_session_path %></div>
  </div>
</section>
