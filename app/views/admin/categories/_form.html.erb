<%= form_with model: [:admin, @category], class: "admin-form" do |form| %>
  <% if @category.errors.any? %>
    <div class="admin-errors">
      <ul>
        <% @category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name, "Tên danh mục" %>
    <%= form.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= form.label :slug, "Slug (để trống để tự sinh)" %>
    <%= form.text_field :slug %>
  </div>

  <div class="admin-actions">
    <%= form.submit @category.new_record? ? "Tạo danh mục" : "Cập nhật", class: "admin-btn" %>
    <%= link_to "Hủy", admin_categories_path, class: "admin-btn admin-btn--secondary" %>
  </div>
<% end %>
