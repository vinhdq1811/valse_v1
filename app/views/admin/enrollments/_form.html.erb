<%= form_with model: [:admin, @enrollment], class: "admin-form" do |form| %>
  <% if @enrollment.errors.any? %>
    <div class="admin-errors">
      <ul>
        <% @enrollment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-grid-2">
    <div class="field">
      <%= form.label :user_id, "Học viên" %>
      <%= form.collection_select :user_id, User.where(role: :student).ordered, :id, :display_name,
            prompt: "Chọn học viên" %>
    </div>

    <div class="field">
      <%= form.label :plan_id, "Khóa học (Gói)" %>
      <%= form.collection_select :plan_id, Plan.ordered, :id, :name, prompt: "Chọn khóa học" %>
    </div>
  </div>

  <div class="admin-grid-2">
    <div class="field">
      <%= form.label :lessons_per_week, "Số buổi tối đa mỗi tuần" %>
      <%= form.number_field :lessons_per_week, min: 1, required: true %>
    </div>

    <div class="field">
      <%= form.label :total_lessons, "Tổng số buổi của khóa" %>
      <%= form.number_field :total_lessons, min: 1, required: true %>
    </div>
  </div>

  <div class="field">
    <div class="checkbox-row">
      <label>
        <%= form.check_box :active %>
        Đang học (cho phép đặt lịch)
      </label>
    </div>
  </div>

  <div class="admin-actions">
    <%= form.submit @enrollment.new_record? ? "Tạo đăng ký" : "Cập nhật", class: "admin-btn" %>
    <%= link_to "Hủy", admin_enrollments_path, class: "admin-btn admin-btn--secondary" %>
  </div>
<% end %>
