<div class="admin-head">
  <h1><%= @post.title %></h1>
  <div class="admin-actions">
    <%= link_to "Sửa", edit_admin_post_path(@post), class: "admin-btn" %>
    <%= link_to "Xem trên website", post_path(@post), target: "_top", class: "admin-btn admin-btn--secondary" %>
    <%= link_to "← Danh sách", admin_posts_path, class: "admin-btn admin-btn--secondary" %>
  </div>
</div>

<p class="admin-meta">
  <span class="admin-badge admin-badge--<%= @post.status %>"><%= @post.status.humanize %></span>
  <span class="admin-badge"><%= @post.category.name %></span>
  Tác giả: <%= @post.author.display_name %> · Đăng: <%= @post.published_at&.strftime("%d/%m/%Y %H:%M") %>
</p>

<% if @post.featured_image.attached? %>
  <figure class="admin-figure"><%= image_tag @post.featured_image.variant(:card), style: "max-width: 420px;" %></figure>
<% end %>

<% if @post.excerpt.present? %>
  <p class="admin-excerpt"><%= @post.excerpt %></p>
<% end %>

<div class="admin-form">
  <%= @post.body %>
</div>
