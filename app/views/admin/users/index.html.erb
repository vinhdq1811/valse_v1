<div class="admin-head">
  <h1>Người dùng</h1>
  <%= link_to "+ Tài khoản mới", new_admin_user_path, class: "admin-btn" %>
</div>

<table class="admin-table">
  <thead>
    <tr>
      <th>Tên</th>
      <th>Email</th>
      <th>Vai trò</th>
      <th>Khóa đang học</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><strong><%= user.display_name %></strong></td>
        <td><%= user.email_address %></td>
        <td>
          <span class="admin-badge admin-badge--<%= user.admin_or_superadmin? ? "published" : "draft" %>">
            <%= { student: "Học viên", teacher: "Giáo viên", admin: "Quản trị", superadmin: "Superadmin" }[user.role.to_sym] %>
          </span>
        </td>
        <td><%= user.enrollments.active.map { |e| e.plan.name }.join(", ").presence || "—" %></td>
        <td>
          <div class="admin-actions">
            <%= link_to "Sửa", edit_admin_user_path(user), class: "admin-btn admin-btn--secondary" %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
